{
  "name": "practice-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JS/TS practice workspace. Add packages to dependencies, then: docker compose restart lab",
  "scripts": {
    "dev": "tsx watch ts/index.ts",
    "run": "tsx",
    "check": "tsc --noEmit",
    "lint": "eslint ts",
    "format": "prettier --write ts",
    "test": "vitest",
    "serve": "vite --host 0.0.0.0 --port 5173"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "vitest": "^2.0.5",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.2"
  }
}
